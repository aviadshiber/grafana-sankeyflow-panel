{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "panel",
  "name": "SankeyFlow",
  "id": "aviadshiber-sankeyflow-panel",
  "info": {
    "keywords": ["panel", "sankey", "flow", "network", "energy"],
    "description": "Interactive Sankey diagrams for multi-stage, circular, and time-varying flows from any Grafana data source.",
    "author": {
      "name": "Aviad Shiber",
      "url": "https://github.com/aviadshiber"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "GitHub",
        "url": "https://github.com/aviadshiber/grafana-sankeyflow-panel"
      },
      {
        "name": "Documentation",
        "url": "https://github.com/aviadshiber/grafana-sankeyflow-panel#readme"
      },
      {
        "name": "Report an issue",
        "url": "https://github.com/aviadshiber/grafana-sankeyflow-panel/issues"
      }
    ],
    "screenshots": [
      {
        "name": "SankeyFlow edge diagram and panel configuration",
        "path": "img/sankeyflow-overview.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=11.5.2",
    "plugins": []
  },
  "state": "alpha"
}
