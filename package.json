{
  "name": "sankeyflow",
  "version": "0.1.0",
  "description": "Interactive Sankey diagrams for multi-stage, circular, and time-varying flows in Grafana.",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "test:fixtures": "python3 .agents/skills/use-sankeyflow/scripts/test_validate_fixtures.py",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "e2e": "playwright test --tsconfig tsconfig.e2e.json",
    "e2e:ui": "playwright test --tsconfig tsconfig.e2e.json --ui",
    "server": "docker compose up --build",
    "sign": "sign-plugin",
    "react:detect": "react-detect",
    "sbom": "npm sbom --sbom-format cyclonedx > sbom.cdx.json"
  },
  "author": "Aviad Shiber",
  "license": "Apache-2.0",
  "homepage": "https://github.com/aviadshiber/grafana-sankeyflow-panel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aviadshiber/grafana-sankeyflow-panel.git"
  },
  "bugs": {
    "url": "https://github.com/aviadshiber/grafana-sankeyflow-panel/issues"
  },
  "keywords": [
    "grafana",
    "grafana-plugin",
    "sankey",
    "data-visualization",
    "flow-diagram"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/plugin-e2e": "^3.6.1",
    "@grafana/react-detect": "^0.7.1",
    "@grafana/sign-plugin": "^3.2.2",
    "@grafana/tsconfig": "^2.0.1",
    "@playwright/test": "^1.57.0",
    "@stylistic/eslint-plugin-ts": "^4.4.0",
    "@swc/core": "^1.15.0",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/d3-sankey": "^0.12.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "brace-expansion": "1.1.17",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jsdoc": "^63.2.2",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-webpack-plugin": "^6.0.0",
    "fast-check": "^4.3.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^13.0.6",
    "identity-obj-proxy": "^3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.6.0",
    "replace-in-file-webpack-plugin": "^1.0.0",
    "sass": "^1.89.0",
    "sass-loader": "^17.0.0",
    "semver": "^7.7.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.0",
    "terser-webpack-plugin": "^5.3.0",
    "ts-node": "^10.9.0",
    "typescript": "5.9.2",
    "webpack": "^5.101.0",
    "webpack-cli": "^7.2.1",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "13.1.1",
    "@grafana/i18n": "13.1.1",
    "@grafana/runtime": "13.1.1",
    "@grafana/schema": "13.1.1",
    "@grafana/ui": "13.1.1",
    "d3-sankey": "^0.12.3",
    "d3-sankey-circular": "^0.34.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "packageManager": "npm@11.17.0"
}
